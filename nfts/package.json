{
  "name": "nft-display-example",
  "version": "1.0.0",
  "description": "NFT display example using Hardhat and React",
  "scripts": {
    "compile": "hardhat compile",
    "deploy": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:kyc": "hardhat run scripts/deploy-kyc.ts --network localhost",
    "mint": "hardhat run scripts/mint.ts --network localhost",
    "node": "hardhat node",
    "test": "hardhat test",
    "dev": "cd frontend && npm run dev",
    "benchmark:zkp": "hardhat run --no-compile --network sepolia scripts/benchmark-zkp.js",
    "benchmark:nft-gas": "hardhat run --no-compile --network sepolia scripts/benchmark-nft-gas.js",
    "benchmark:halo2-gas": "hardhat run --no-compile --network sepolia scripts/benchmark-halo2-gas.js",
    "benchmark:zkp:local": "hardhat run --no-compile scripts/benchmark-zkp.js",
    "benchmark:nft-gas:local": "hardhat run --no-compile scripts/benchmark-nft-gas.js",
    "benchmark:halo2-gas:local": "hardhat run --no-compile scripts/benchmark-halo2-gas.js"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/node": "^20.0.0",
    "hardhat": "^2.19.0",
    "solc": "^0.8.28",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.0"
  }
}
