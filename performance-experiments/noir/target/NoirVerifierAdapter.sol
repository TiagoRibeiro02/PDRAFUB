pragma solidity ^0.8.21;

import "./Verifier.sol";

/**
 * @title NoirVerifierAdapter
 * @dev Adapter between the generic IProofVerifier interface used by
 *      KYCCompliance and the Noir/Barretenberg UltraHonk verifier.
 *
 *      The current Noir KYC circuit exposes 5 public inputs:
 *        0. DID
 *        1. status
 *        2. commitment
 *        3. issuer
 *        4. expiry
 */
contract NoirVerifierAdapter {
    HonkVerifier public honkVerifier;

    uint256 public constant NUM_PUBLIC_INPUTS = 5;

    event ProofChecked(bool valid);

    constructor(address verifierAddress) {
        require(verifierAddress != address(0), "Invalid verifier address");
        honkVerifier = HonkVerifier(verifierAddress);
    }

    /**
     * @dev Verify a Noir UltraHonk proof.
     *
     * @param proof The UltraHonk proof generated by Barretenberg.
     * @param pubSignals The five public inputs of the Noir circuit:
     *        [DID, status, commitment, issuer, expiry]
     *
     * @return True if the proof is valid.
     */
    function verifyProof(
        bytes memory proof,
        uint[] memory pubSignals
    )
        public
        view
        returns (bool)
    {
        require(
            pubSignals.length == NUM_PUBLIC_INPUTS,
            "Invalid number of public signals (expected 5 for Noir)"
        );

        // Convert uint[] to bytes32[]
        bytes32[] memory publicInputs =
            new bytes32[](NUM_PUBLIC_INPUTS);

        for (uint256 i = 0; i < NUM_PUBLIC_INPUTS; i++) {
            publicInputs[i] = bytes32(pubSignals[i]);
        }

        return honkVerifier.verify(proof, publicInputs);
    }

    /**
     * @dev Transactional version of proof verification.
     *      Useful when an on-chain event is required.
     */
    function verifyProofTx(
        bytes memory proof,
        uint[] memory pubSignals
    )
        external
        returns (bool)
    {
        bool valid = verifyProof(proof, pubSignals);

        emit ProofChecked(valid);

        return valid;
    }

    /**
     * @dev Return the address of the underlying UltraHonk verifier.
     */
    function getVerifierAddress()
        external
        view
        returns (address)
    {
        return address(honkVerifier);
    }
}